{#
    admin_product_edit.html.twig
    Cette page affiche le formulaire pré-rempli pour MODIFIER un produit existant.
    Les champs sont déjà remplis avec les données actuelles du produit.
    L'admin modifie ce qu'il veut et soumet le formulaire.
    Le contrôleur AdminProductController::adminProductEdit() gère la soumission.
#}

{% extends 'base.html.twig' %}

{# On met le nom du produit dans le titre de l'onglet pour savoir ce qu'on édite #}
{% block title %}Admin — Modifier {{ product.name }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            {# ============================================================ #}
            {# EN-TÊTE                                                        #}
            {# ============================================================ #}
            <div class="d-flex align-items-center mb-4 gap-3">
                <a href="{{ path('app_admin_products_list') }}"
                   class="btn btn-outline-secondary rounded-circle"
                   style="width: 42px; height: 42px; padding: 0; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h1 class="fw-bold mb-0">
                        <i class="bi bi-pencil-square text-warning me-2"></i>
                        Modifier le produit
                    </h1>
                    {# On affiche le nom et le SKU du produit qu'on est en train de modifier #}
                    <p class="text-muted mb-0 small">
                        <code class="text-primary">{{ product.sku }}</code> — {{ product.name }}
                    </p>
                </div>
            </div>

            {# ============================================================ #}
            {# APERÇU RAPIDE DU PRODUIT (image + infos clés)                  #}
            {# Utile pour se rappeler ce qu'on est en train de modifier        #}
            {# ============================================================ #}
            {% if product.image %}
            <div class="card border-0 bg-light rounded-4 mb-4 p-3 d-flex flex-row align-items-center gap-3">
                <img src="{{ product.image }}" alt="{{ product.name }}"
                     class="rounded-3 object-fit-cover shadow-sm"
                     style="width: 80px; height: 80px;">
                <div>
                    <div class="fw-bold">{{ product.name }}</div>
                    <div class="text-muted small">
                        Prix TTC actuel :
                        <strong class="text-primary">
                            {# On recalcule le prix TTC = prix_ht × (1 + tva) #}
                            {{ (product.prixHt * (1 + product.vatRate))|number_format(2, ',', ' ') }} €
                        </strong>
                        — Stock : <strong>{{ product.quantity }} unités</strong>
                    </div>
                </div>
            </div>
            {% endif %}

            {# ============================================================ #}
            {# MESSAGES FLASH                                                 #}
            {# ============================================================ #}
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show rounded-3" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {# ============================================================ #}
            {# CARTE FORMULAIRE (identique au formulaire d'ajout,             #}
            {# mais les champs sont pré-remplis avec les données du produit)  #}
            {# ============================================================ #}
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-lg-5">

                    {{ form_start(form) }}

                    {# ---- Section identité ---- #}
                    <h5 class="fw-bold mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: .1em; color: #6c757d;">
                        <i class="bi bi-tag me-1"></i> Identité du produit
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            {{ form_label(form.name) }}
                            {{ form_widget(form.name) }}
                            {{ form_errors(form.name) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.sku) }}
                            {{ form_widget(form.sku) }}
                            {{ form_errors(form.sku) }}
                            <div class="form-text">Attention : le SKU est la référence unique du produit.</div>
                        </div>
                    </div>

                    {# ---- Section prix & stock ---- #}
                    <h5 class="fw-bold mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: .1em; color: #6c757d;">
                        <i class="bi bi-currency-euro me-1"></i> Prix & Stock
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            {{ form_label(form.prix_ht) }}
                            <div class="input-group">
                                {{ form_widget(form.prix_ht) }}
                                <span class="input-group-text">€ HT</span>
                            </div>
                            {{ form_errors(form.prix_ht) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.vat_rate) }}
                            <div class="input-group">
                                {{ form_widget(form.vat_rate) }}
                                <span class="input-group-text">TVA</span>
                            </div>
                            {{ form_errors(form.vat_rate) }}
                            <div class="form-text">0.20 = 20%, 0.055 = 5.5%</div>
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.quantity) }}
                            <div class="input-group">
                                {{ form_widget(form.quantity) }}
                                <span class="input-group-text">unités</span>
                            </div>
                            {{ form_errors(form.quantity) }}
                        </div>
                    </div>

                    {# ---- Section catégorie & image ---- #}
                    <h5 class="fw-bold mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: .1em; color: #6c757d;">
                        <i class="bi bi-grid me-1"></i> Catégorie & Image
                    </h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            {{ form_label(form.category) }}
                            {{ form_widget(form.category) }}
                            {{ form_errors(form.category) }}
                        </div>
                        <div class="col-md-8">
                            {{ form_label(form.image) }}
                            {{ form_widget(form.image) }}
                            {{ form_errors(form.image) }}
                        </div>
                    </div>

                    {# ---- Section description ---- #}
                    <h5 class="fw-bold mb-3 text-uppercase" style="font-size: 0.8rem; letter-spacing: .1em; color: #6c757d;">
                        <i class="bi bi-card-text me-1"></i> Description
                    </h5>
                    <div class="mb-4">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description) }}
                        {{ form_errors(form.description) }}
                    </div>

                    {# ---- Boutons d'action ---- #}
                    <div class="d-flex flex-wrap gap-3 pt-2">
                        <button type="submit" class="btn btn-warning rounded-pill px-5 fw-bold shadow-sm text-dark">
                            <i class="bi bi-check-lg me-1"></i> Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_admin_products_list') }}" class="btn btn-outline-secondary rounded-pill px-4">
                            Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>

            {# ============================================================ #}
            {# ZONE DANGER — Suppression du produit                          #}
            {# On la met tout en bas et en rouge pour éviter les accidents   #}
            {# ============================================================ #}
            <div class="card border-danger rounded-4 mt-4">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-danger fw-bold mb-1"><i class="bi bi-exclamation-triangle me-1"></i> Zone de danger</h6>
                        <p class="text-muted small mb-0">La suppression est définitive et ne peut pas être annulée.</p>
                    </div>

                    {# Formulaire de suppression avec confirmation JavaScript #}
                    <form method="POST"
                          action="{{ path('app_admin_product_delete', {'id': product.id}) }}"
                          onsubmit="return confirm('Supprimer définitivement « {{ product.name }} » ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}">
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">
                            <i class="bi bi-trash me-1"></i> Supprimer ce produit
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
