{# page affichee apres un paiement Stripe reussi #}
{% extends 'base.html.twig' %}

{% block title %}Paiement réussi - ShoppingFree{% endblock %}

{% block body %}
<div class="container py-5 text-center" style="min-height: 60vh; display: flex; align-items: center; justify-content: center;">
    <div>
        {# grande icone verte de confirmation #}
        <div class="mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
        </div>
        <h1 class="fw-bold mb-2">Paiement réussi !</h1>
        <p class="text-muted fs-5 mb-4">Merci pour votre commande. Retrouvez vos achats dans <strong>Mes Commandes</strong>.</p>

        {# deux boutons : voir mes commandes ou continuer a acheter #}
        <div class="d-flex justify-content-center gap-3">
            <a href="{{ path('app_account_orders') }}" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                <i class="bi bi-list-check me-2"></i>Mes Commandes
            </a>
            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary btn-lg rounded-pill px-5 fw-bold">
                <i class="bi bi-shop me-2"></i>Continuer mes achats
            </a>
        </div>
    </div>
</div>
{% endblock %}
